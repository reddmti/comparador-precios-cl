# Copia este archivo como .env y completa el valor. El archivo .env no se versiona.
# Supabase entrega la cadena en: Project Settings > Database > Connection string > URI
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=postgresql+psycopg2://postgres:CONTRASENA@db.PROYECTO.supabase.co:5432/postgres

# Sin esta variable el sistema usa un archivo SQLite local (comparador.db) y funciona igual.
